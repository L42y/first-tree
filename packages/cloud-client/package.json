{
  "name": "@first-tree/cloud-client",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "First Tree Cloud HTTP SDK, token/retry, SdkError, and client observability (internal)",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./observability": {
      "types": "./src/observability/index.ts",
      "import": "./dist/observability/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/observability/index.ts --format esm --no-dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --testTimeout=10000 --passWithNoTests"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@sentry/node": "^10.62.0",
    "pino": "^9.5.0",
    "zod": "^4.0.0",
    "@first-tree/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@vitest/coverage-v8": "3.2.4",
    "tsdown": "^0.21.4",
    "vitest": "^3.2.0"
  }
}
