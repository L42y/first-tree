{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://first-tree.dev/schemas/return-meeting-context-decision-evidence-packet-v1.json",
  "title": "Meeting Decision Evidence Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_revision", "status", "reason", "handoff", "candidates"],
  "properties": {
    "schema": {
      "const": "return-meeting-context.decision-evidence-packet.v1"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": ["no-change", "needs-confirmation", "ready-for-write", "blocked-source"]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "handoff": {
      "enum": ["none", "first-tree-write"]
    },
    "candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "settlement", "chronology", "evidence"],
        "properties": {
          "claim": {
            "type": "object",
            "additionalProperties": false,
            "required": ["what", "why", "constraints"],
            "properties": {
              "what": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "constraints": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              }
            }
          },
          "settlement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "basis"],
            "properties": {
              "status": {
                "enum": ["settled", "uncertain"]
              },
              "basis": {
                "enum": [
                  "human_confirmed_minutes",
                  "explicit_decision_record",
                  "transcript_explicit_human_choice",
                  "ai_generated_summary",
                  "unknown"
                ]
              }
            }
          },
          "chronology": {
            "type": "object",
            "additionalProperties": false,
            "required": ["later_override_checked", "overridden_claims_excluded"],
            "properties": {
              "later_override_checked": {
                "type": "boolean"
              },
              "overridden_claims_excluded": {
                "type": "boolean"
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact_id", "location_hint"],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                },
                "location_hint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          }
        }
      }
    }
  }
}
