{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://first-tree.dev/schemas/return-meeting-context.analysis-output.v1.json",
  "title": "Return Meeting Context Analysis Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "tree_main_commit", "meeting_results"],
  "properties": {
    "schema": {
      "const": "return-meeting-context.analysis-output.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "tree_main_commit": {
      "type": ["string", "null"]
    },
    "meeting_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/meetingResult"
      }
    }
  },
  "$defs": {
    "meetingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meeting_id", "source_revision", "disposition", "reason", "candidates"],
      "properties": {
        "meeting_id": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "disposition": {
          "enum": ["no-change", "candidates", "blocked-source", "failed"]
        },
        "reason": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_revision",
        "disposition",
        "claim",
        "target",
        "settlement",
        "chronology",
        "dedupe",
        "revisit_trigger"
      ],
      "properties": {
        "candidate_revision": {
          "type": "integer",
          "minimum": 1
        },
        "disposition": {
          "enum": [
            "draft-eligible",
            "already-present",
            "already-proposed",
            "revisit",
            "skip",
            "blocked-source",
            "failed"
          ]
        },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["what", "why", "constraints"],
          "properties": {
            "what": {
              "type": "string",
              "minLength": 12
            },
            "why": {
              "type": "string",
              "minLength": 12
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path_hint"],
          "properties": {
            "path_hint": {
              "type": "string"
            }
          }
        },
        "settlement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidence", "confirmation_member_ids"],
          "properties": {
            "status": {
              "enum": ["settled", "unsettled", "unknown"]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source_ref", "excerpt"],
                "properties": {
                  "source_ref": {
                    "type": "string"
                  },
                  "excerpt": {
                    "type": "string"
                  }
                }
              }
            },
            "confirmation_member_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "chronology": {
          "type": "object",
          "additionalProperties": false,
          "required": ["later_override_checked"],
          "properties": {
            "later_override_checked": {
              "type": "boolean"
            }
          }
        },
        "dedupe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tree_main_checked", "open_proposals_checked", "status"],
          "properties": {
            "tree_main_checked": {
              "type": "boolean"
            },
            "open_proposals_checked": {
              "type": "boolean"
            },
            "status": {
              "enum": ["absent", "present", "proposed", "unknown"]
            }
          }
        },
        "revisit_trigger": {
          "type": "string"
        }
      }
    }
  }
}
