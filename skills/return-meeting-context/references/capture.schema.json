{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://first-tree.dev/schemas/return-meeting-context.capture.v1.json",
  "title": "Return Meeting Context Capture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "provider", "captured_at", "discovery_complete", "meetings"],
  "properties": {
    "schema": {
      "const": "return-meeting-context.capture.v1"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_key": {
      "type": ["string", "null"]
    },
    "discovery_complete": {
      "type": "boolean"
    },
    "discovery_watermark": {},
    "tree_main_commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "adapter": {
      "type": "object"
    },
    "ephemeral_root": {
      "type": "string"
    },
    "meetings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/meeting"
      }
    }
  },
  "$defs": {
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_meeting_id", "owner_provider_id", "started_at", "source_status", "segments"],
      "properties": {
        "provider_meeting_id": {
          "type": "string",
          "minLength": 1
        },
        "calendar_event_id": {
          "type": ["string", "null"]
        },
        "owner_provider_id": {
          "type": ["string", "null"]
        },
        "title_hint": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "source_status": {
          "enum": ["complete", "partial", "failed"]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "source_revision", "started_at", "text_file"],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "source_revision": {
                "type": "string",
                "minLength": 1
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "ended_at": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "text_file": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
