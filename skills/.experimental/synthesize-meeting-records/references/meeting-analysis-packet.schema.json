{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meeting Analysis Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_revision", "status", "reason", "items"],
  "properties": {
    "schema": {
      "const": "synthesize-meeting-records.meeting-analysis-packet.v1"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": ["complete", "needs-confirmation", "no-findings", "blocked-source"]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "items": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "statement", "context", "settlement", "chronology", "evidence"],
        "properties": {
          "category": {
            "enum": ["decision", "progress", "plan", "action", "blocker", "risk"]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "settlement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "basis"],
            "properties": {
              "status": {
                "enum": ["confirmed", "uncertain"]
              },
              "basis": {
                "enum": [
                  "human_confirmed_minutes",
                  "explicit_decision_record",
                  "transcript_explicit_human_statement",
                  "ai_generated_summary",
                  "unknown"
                ]
              }
            }
          },
          "chronology": {
            "type": "object",
            "additionalProperties": false,
            "required": ["later_override_checked", "overridden_items_excluded"],
            "properties": {
              "later_override_checked": {
                "type": "boolean"
              },
              "overridden_items_excluded": {
                "type": "boolean"
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact_id", "location_hint"],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                },
                "location_hint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          }
        }
      }
    }
  }
}
