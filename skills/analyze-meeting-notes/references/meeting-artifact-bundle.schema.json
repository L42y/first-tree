{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meeting Artifact Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "meeting_scope", "artifacts"],
  "properties": {
    "schema": {
      "const": "analyze-meeting-notes.artifact-bundle.v1"
    },
    "meeting_scope": {
      "const": "single-meeting"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "input_kind",
          "media_type",
          "source_role",
          "revision",
          "completeness",
          "chronology_index",
          "content_ref",
          "extraction_warnings"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "input_kind": {
            "enum": ["provider_link", "attachment", "local_file", "pasted_text"]
          },
          "media_type": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "source_role": {
            "enum": ["human_minutes", "ai_notes", "transcript", "decision_record", "unknown"]
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "completeness": {
            "enum": ["complete", "partial", "unknown"]
          },
          "chronology_index": {
            "type": "integer",
            "minimum": 0
          },
          "content_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "locator"],
            "properties": {
              "kind": {
                "enum": ["conversation", "task_file"]
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          },
          "extraction_warnings": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        }
      }
    }
  }
}
